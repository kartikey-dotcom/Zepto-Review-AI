# ==============================================================================
#                     ZEPTO REVIEWS AI — CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials and settings.
# DO NOT commit '.env' with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project & Application Core Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="Zepto Reviews AI"
ENVIRONMENT="development"              # Options: development, staging, production
LOG_LEVEL="INFO"                       # Options: DEBUG, INFO, WARNING, ERROR
API_V1_STR="/api/v1"
HOST="127.0.0.1"
PORT=8000

# ------------------------------------------------------------------------------
# 2. Target Play Store App Configuration
# ------------------------------------------------------------------------------
ZEPTO_PACKAGE_NAME="com.zepto.customer" # Official Zepto Android Play Store Package Name
PLAYSTORE_DEFAULT_COUNT=50

# ------------------------------------------------------------------------------
# 3. Database Connection Settings
# ------------------------------------------------------------------------------
# Development (Async SQLite DB)
DATABASE_URL="sqlite+aiosqlite:///./zepto_reviews.db"

# Production (PostgreSQL + pgvector)
# DATABASE_URL="postgresql+asyncpg://zepto_user:secure_password@localhost:5432/zepto_reviews_db"

# ------------------------------------------------------------------------------
# 4. Google AI Studio (Gemini API) & LLM Rate Limits
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_google_ai_studio_api_key_here"
GEMINI_MODEL_NAME="gemini-1.5-flash"
